<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.ui.layout.form">
  <Dialog id="approvalDialog" title="{dialog>/title}" draggable="true" resizable="true">
    <content>
      <f:SimpleForm editable="true" layout="ResponsiveGridLayout" class="sapUiResponsiveMargin" labelSpanL="12" labelSpanM="12">
        <f:content>
          <Label text="Comment / Reason (required for reject and override)"/>
          <TextArea id="approvalComment" value="{dialog>/comment}" growing="true" growingMaxLines="6" width="100%" rows="4"/>
        </f:content>
      </f:SimpleForm>
    </content>
    <buttons>
      <Button id="confirmBtn" text="{dialog>/confirmText}" type="{dialog>/confirmType}" press="onConfirmApproval"/>
      <Button text="{i18n>btnCancel}" press="onCancelApproval"/>
    </buttons>
  </Dialog>
</core:FragmentDefinition>
