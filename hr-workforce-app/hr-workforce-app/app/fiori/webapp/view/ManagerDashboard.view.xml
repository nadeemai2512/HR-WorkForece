<mvc:View
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:l="sap.ui.layout"
  xmlns:core="sap.ui.core"
  displayBlock="true"
  controllerName="hr.fiori.controller.ManagerDashboard"
  height="100%">
  <Page title="{i18n>titleManagerDashboard}" showNavButton="true" navButtonPress="onNavBack">
    <headerContent>
      <Button icon="sap-icon://calendar" text="{i18n>teamPlanning}" press="onGoPlanning"/>
      <Button icon="sap-icon://approvals" text="{i18n>titleApprovals}" type="Emphasized" press="onGoApprovals"/>
    </headerContent>

    <ScrollContainer height="100%" width="100%" vertical="true">
      <l:Grid class="dashboardGrid" defaultSpan="L3 M6 S12">

        <GenericTile class="kpiTile" header="{i18n>tileTotalTeam}" press="onGoPlanning">
          <customData><core:CustomData key="route" value="planning"/></customData>
          <tileContent><TileContent><NumericContent value="{appView>/managerDashboard/totalTeam}" icon="sap-icon://group"/></TileContent></tileContent>
        </GenericTile>

        <GenericTile class="kpiTile" header="{i18n>tilePresent}" press="onGoPlanning">
          <customData><core:CustomData key="route" value="planning"/></customData>
          <tileContent><TileContent><NumericContent value="{appView>/managerDashboard/present}" icon="sap-icon://employee-approvals" state="Good"/></TileContent></tileContent>
        </GenericTile>

        <GenericTile class="kpiTile" header="{i18n>tileOnLeave}" press="onGoPlanning">
          <customData><core:CustomData key="route" value="planning"/></customData>
          <tileContent><TileContent><NumericContent value="{appView>/managerDashboard/onLeave}" icon="sap-icon://calendar" state="Error"/></TileContent></tileContent>
        </GenericTile>

        <GenericTile class="kpiTile" header="{i18n>tileStaffing}" press="onGoPlanning">
          <customData><core:CustomData key="route" value="planning"/></customData>
          <tileContent><TileContent><NumericContent value="{appView>/managerDashboard/staffingPercent}" scale="%" icon="sap-icon://measurement"/></TileContent></tileContent>
        </GenericTile>

        <GenericTile class="kpiTile" header="{i18n>tilePendingLeaveApp}" press="onGoApprovalsLeave">
          <tileContent><TileContent><NumericContent value="{appView>/managerDashboard/pendingLeaveApprovals}" icon="sap-icon://pending" state="Warning"/></TileContent></tileContent>
        </GenericTile>

        <GenericTile class="kpiTile" header="{i18n>tilePendingOTApp}" press="onGoApprovalsOvertime">
          <tileContent><TileContent><NumericContent value="{appView>/managerDashboard/pendingOvertimeApprovals}" icon="sap-icon://pending" state="Warning"/></TileContent></tileContent>
        </GenericTile>

        <GenericTile class="kpiTile" header="{i18n>tilePendingSwap}" press="onGoApprovalsSwap">
          <tileContent><TileContent><NumericContent value="{appView>/managerDashboard/pendingSwapRequests}" icon="sap-icon://pending" state="Warning"/></TileContent></tileContent>
        </GenericTile>

        <GenericTile class="kpiTile" header="{i18n>tileComplianceAlerts}" press="onGoReports">
          <tileContent><TileContent><NumericContent value="{appView>/managerDashboard/complianceAlerts}" icon="sap-icon://alert" state="Error"/></TileContent></tileContent>
        </GenericTile>
      </l:Grid>

      <Panel headerText="{i18n>teamPlanning}" class="sapUiResponsiveMargin" expandable="true" expanded="true">
        <Table id="teamTable" items="{/Employees}" growing="true" growingThreshold="20" noDataText="{i18n>msgNoData}">
          <columns>
            <Column><Text text="{i18n>colEmployee}"/></Column>
            <Column><Text text="{i18n>colDepartment}"/></Column>
            <Column><Text text="Job Title"/></Column>
            <Column><Text text="{i18n>colStatus}"/></Column>
          </columns>
          <items>
            <ColumnListItem type="Navigation" press="onTeamMemberPress">
              <cells>
                <Text text="{fullName} ({employeeNo})"/>
                <Text text="{department_code}"/>
                <Text text="{jobTitle}"/>
                <ObjectStatus text="{status}" state="None"/>
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </Panel>
    </ScrollContainer>
  </Page>
</mvc:View>
