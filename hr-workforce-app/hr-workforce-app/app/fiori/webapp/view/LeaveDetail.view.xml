<mvc:View
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:f="sap.ui.layout.form"
  xmlns:core="sap.ui.core"
  displayBlock="true"
  controllerName="hr.fiori.controller.LeaveDetail"
  height="100%">
  <Page title="{i18n>titleLeaveDetail}" showNavButton="true" navButtonPress="onNavBack">
    <content>
      <ObjectHeader title="{path:'leaveType_code', formatter:'.formatter.leaveTypeText'}"
        number="{path:'days', type:'sap.ui.model.odata.type.Decimal', formatOptions:{maxFractionDigits:1}}"
        numberUnit="days"
        state="{path:'status', formatter:'.formatter.statusState'}">
        <statuses>
          <ObjectStatus text="{path:'status', formatter:'.formatter.statusText'}" state="{path:'status', formatter:'.formatter.statusState'}"/>
        </statuses>
      </ObjectHeader>

      <f:SimpleForm editable="false" layout="ResponsiveGridLayout" class="sapUiResponsiveMargin"
        labelSpanL="3" labelSpanM="4" columnsL="1">
        <f:content>
          <Label text="{i18n>colEmployee}"/><Text text="{employeeNo}"/>
          <Label text="{i18n>colLeaveType}"/><Text text="{path:'leaveType_code', formatter:'.formatter.leaveTypeText'}"/>
          <Label text="{i18n>colStartDate}"/><Text text="{path:'startDate', type:'sap.ui.model.odata.type.Date'}"/>
          <Label text="{i18n>colEndDate}"/><Text text="{path:'endDate', type:'sap.ui.model.odata.type.Date'}"/>
          <Label text="{i18n>colDays}"/><Text text="{path:'days', type:'sap.ui.model.odata.type.Decimal'}"/>
          <Label text="{i18n>colStatus}"/><ObjectStatus text="{path:'status', formatter:'.formatter.statusText'}" state="{path:'status', formatter:'.formatter.statusState'}"/>
          <Label text="Medical Certificate Required"/><Text text="{path:'medicalCertRequired', formatter:'.formatter.boolText'}"/>
          <Label text="{i18n>colReason}"/><Text text="{reason}"/>
          <Label text="Manager Comment"/><Text text="{managerComment}"/>
          <Label text="Coverage Override"/><Text text="{path:'coverageOverrideApplied', formatter:'.formatter.boolText'}"/>
          <Label text="Override Reason"/><Text text="{coverageOverrideReason}"/>
        </f:content>
      </f:SimpleForm>

      <Panel headerText="Approval History" class="sapUiResponsiveMargin">
        <Table items="{approvals}" noDataText="{i18n>msgNoData}">
          <columns>
            <Column><Text text="Action"/></Column>
            <Column><Text text="Approver"/></Column>
            <Column><Text text="From"/></Column>
            <Column><Text text="To"/></Column>
            <Column><Text text="Comments"/></Column>
            <Column><Text text="Timestamp"/></Column>
          </columns>
          <items>
            <ColumnListItem>
              <cells>
                <Text text="{action}"/>
                <Text text="{approverName}"/>
                <Text text="{fromStatus}"/>
                <Text text="{toStatus}"/>
                <Text text="{comments}"/>
                <Text text="{path:'timestamp', type:'sap.ui.model.odata.type.DateTime'}"/>
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </Panel>

      <Panel headerText="Attachments" class="sapUiResponsiveMargin">
        <Table items="{attachments}" noDataText="{i18n>msgNoData}">
          <columns>
            <Column><Text text="File Name"/></Column>
            <Column><Text text="Type"/></Column>
          </columns>
          <items>
            <ColumnListItem>
              <cells>
                <Link text="{fileName}" press="onDownloadAttachment"/>
                <Text text="{mediaType}"/>
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </Panel>
    </content>
    <footer>
      <Toolbar>
        <Button id="cancelBtn" text="{i18n>btnCancel}" type="Reject" press="onCancelRequest" visible="false"/>
        <ToolbarSpacer/>
        <Button text="{i18n>btnBack}" press="onNavBack"/>
      </Toolbar>
    </footer>
  </Page>
</mvc:View>
