<mvc:View
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:f="sap.ui.layout.form"
  xmlns:core="sap.ui.core"
  displayBlock="true"
  controllerName="hr.fiori.controller.ShiftSwapCreate"
  height="100%">
  <Page title="{i18n>titleShiftSwap}" showNavButton="true" navButtonPress="onNavBack">
    <content>
      <f:SimpleForm editable="false" layout="ResponsiveGridLayout" class="sapUiResponsiveMargin" labelSpanL="3" labelSpanM="4">
        <f:content>
          <Label text="Shift Date"/><Text text="{path:'shiftDate', type:'sap.ui.model.odata.type.Date'}"/>
          <Label text="Template"/><Text text="{template_code}"/>
          <Label text="Time"/><Text text="{startTime} - {endTime}"/>
          <Label text="Requestor"/><Text text="{appView>/currentUserNo}"/>
        </f:content>
      </f:SimpleForm>

      <f:SimpleForm editable="true" layout="ResponsiveGridLayout" class="sapUiResponsiveMargin" labelSpanL="3" labelSpanM="4">
        <f:content>
          <Label text="Swap With" required="true"/>
          <Select id="targetSelect" items="{swapCandidates>/}">
            <core:Item key="{swapCandidates>employeeNo}" text="{swapCandidates>fullName} ({swapCandidates>employeeNo}) — {swapCandidates>messages}"/>
          </Select>
          <Label text="{i18n>colReason}" required="true"/>
          <TextArea id="reason" growing="true" width="100%"/>
        </f:content>
      </f:SimpleForm>
    </content>
    <footer>
      <Toolbar>
        <ToolbarSpacer/>
        <Button text="{i18n>btnSubmit}" type="Emphasized" press="onSubmit"/>
        <Button text="{i18n>btnCancel}" press="onNavBack"/>
      </Toolbar>
    </footer>
  </Page>
</mvc:View>
