<mvc:View
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:unified="sap.ui.unified"
  xmlns:core="sap.ui.core"
  displayBlock="true"
  controllerName="hr.fiori.controller.TeamPlanningCalendar"
  height="100%">
  <Page title="{i18n>titleTeamPlanning}" showNavButton="true" navButtonPress="onNavBack">
    <subHeader>
      <Toolbar>
        <Label text="{i18n>filterDepartment}"/>
        <Select id="deptFilter" selectedKey="ALL" change="onFilterChange" items="{/Departments}">
          <core:Item key="ALL" text="All Departments"/>
          <core:Item key="{code}" text="{name}"/>
        </Select>
        <Label text="{i18n>filterEmployee}"/>
        <SearchField id="empSearch" width="200px" liveChange="onFilterChange"/>
        <ToolbarSpacer/>
        <Select id="viewRange" selectedKey="W" change="onViewChange">
          <core:Item key="D" text="Day"/>
          <core:Item key="W" text="Week"/>
          <core:Item key="M" text="Month"/>
        </Select>
      </Toolbar>
    </subHeader>

    <VBox class="sapUiResponsiveMargin">
      <PlanningCalendar id="planningCal"
        rows="{path:'/Employees'}"
        viewKey="W"
        appointmentSelect="onAppointmentSelect"
        rowSelectionChange="onRowSelect">
        <rows>
          <PlanningCalendarRow
            title="{fullName}"
            text="{employeeNo}"
            key="{employeeNo}"
            appointments="{path:'shifts'}"
            appointmentsVisualization="Filled">
            <appointments>
              <unified:PlanningCalendarAppointment
                startDate="{parts:[{path:'shiftDate'},{path:'startTime'}], formatter:'.formatter.shiftStart}"
                endDate="{parts:[{path:'shiftDate'},{path:'endTime'},{path:'crossesMidnight'}], formatter:'.formatter.shiftEnd}"
                title="{template_code}"
                text="{startTime}-{endTime}"
                type="{path:'template_code', formatter:'.formatter.appointmentType'}"/>
            </appointments>
          </PlanningCalendarRow>
        </rows>
      </PlanningCalendar>
    </VBox>

    <Panel headerText="Legend" class="sapUiResponsiveMargin">
      <l:Grid xmlns:l="sap.ui.layout" defaultSpan="L3 M6 S12">
        <HBox class="legendBox legendShift"><Text text="{i18n>legendShift} (Morning / General / Night)"/></HBox>
        <HBox class="legendBox legendLeave"><Text text="{i18n>legendLeave} — see Approvals"/></HBox>
        <HBox class="legendBox legendOvertime"><Text text="{i18n>legendOvertime} — see Overtime list"/></HBox>
        <HBox class="legendBox legendSwap"><Text text="{i18n>legendSwap} — see Approvals"/></HBox>
      </l:Grid>
    </Panel>
  </Page>
</mvc:View>
