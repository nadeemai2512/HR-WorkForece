<mvc:View
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  displayBlock="true"
  controllerName="hr.fiori.controller.Approvals"
  height="100%">
  <Page title="{i18n>titleApprovals}" showNavButton="true" navButtonPress="onNavBack">
    <IconTabBar id="approvalsTabs" select="onTabSelect" selectedKey="leave">
      <items>
        <!-- LEAVE -->
        <IconTabFilter key="leave" icon="sap-icon://calendar" text="{i18n>titleLeaveList}">
          <Table id="leaveApprovals" items="{/LeaveRequests}" noDataText="{i18n>msgNoData}" growing="true" growingThreshold="20">
            <columns>
              <Column><Text text="{i18n>colEmployee}"/></Column>
              <Column><Text text="{i18n>colLeaveType}"/></Column>
              <Column><Text text="{i18n>colStartDate}"/></Column>
              <Column><Text text="{i18n>colEndDate}"/></Column>
              <Column><Text text="{i18n>colDays}"/></Column>
              <Column><Text text="{i18n>colReason}"/></Column>
              <Column><Text text="{i18n>colAction}"/></Column>
            </columns>
            <items>
              <ColumnListItem>
                <cells>
                  <Text text="{employeeNo}"/>
                  <Text text="{path:'leaveType_code', formatter:'.formatter.leaveTypeText'}"/>
                  <Text text="{path:'startDate', type:'sap.ui.model.odata.type.Date'}"/>
                  <Text text="{path:'endDate', type:'sap.ui.model.odata.type.Date'}"/>
                  <Text text="{path:'days', type:'sap.ui.model.odata.type.Decimal'}"/>
                  <Text text="{reason}" maxLines="2"/>
                  <HBox>
                    <Button icon="sap-icon://detail-view" type="Transparent" tooltip="View Details" press="onViewLeaveDetails"/>
                    <Button icon="sap-icon://employee" type="Transparent" tooltip="View Employee" press="onViewEmployee"/>
                    <Button icon="sap-icon://accept" type="Accept" tooltip="{i18n>btnApprove}" press="onApproveLeave"/>
                    <Button icon="sap-icon://sys-cancel-2" type="Reject" tooltip="{i18n>btnReject}" press="onRejectLeave"/>
                    <Button icon="sap-icon://undo" type="Transparent" tooltip="{i18n>btnSendBack}" press="onSendBackLeave"/>
                  </HBox>
                </cells>
              </ColumnListItem>
            </items>
          </Table>
        </IconTabFilter>

        <!-- OVERTIME -->
        <IconTabFilter key="overtime" icon="sap-icon://overtime" text="{i18n>titleOvertimeList}">
          <Table id="otApprovals" items="{/OvertimeRequests}" noDataText="{i18n>msgNoData}" growing="true" growingThreshold="20">
            <columns>
              <Column><Text text="{i18n>colEmployee}"/></Column>
              <Column><Text text="{i18n>colWorkDate}"/></Column>
              <Column><Text text="{i18n>colOtHours}"/></Column>
              <Column><Text text="{i18n>colOtType}"/></Column>
              <Column><Text text="{i18n>colAmount}"/></Column>
              <Column><Text text="{i18n>colReason}"/></Column>
              <Column><Text text="Compliance"/></Column>
              <Column><Text text="{i18n>colAction}"/></Column>
            </columns>
            <items>
              <ColumnListItem>
                <cells>
                  <Text text="{employeeNo}"/>
                  <Text text="{path:'workDate', type:'sap.ui.model.odata.type.Date'}"/>
                  <Text text="{path:'otHours', type:'sap.ui.model.odata.type.Decimal'}"/>
                  <Text text="{path:'otType', formatter:'.formatter.otTypeText'}"/>
                  <Text text="{path:'estimatedAmount', type:'sap.ui.model.odata.type.Decimal', formatOptions:{showMeasure:false}}"/>
                  <Text text="{reason}" maxLines="2"/>
                  <Text text="{complianceMessages}" maxLines="3" wrapping="true"/>
                  <HBox>
                    <Button icon="sap-icon://employee" type="Transparent" tooltip="View Employee" press="onViewEmployee"/>
                    <Button icon="sap-icon://accept" type="Accept" tooltip="{i18n>btnApprove}" press="onApproveOvertime"/>
                    <Button icon="sap-icon://sys-cancel-2" type="Reject" tooltip="{i18n>btnReject}" press="onRejectOvertime"/>
                    <Button icon="sap-icon://undo" type="Transparent" tooltip="{i18n>btnSendBack}" press="onSendBackOvertime"/>
                  </HBox>
                </cells>
              </ColumnListItem>
            </items>
          </Table>
        </IconTabFilter>

        <!-- SHIFT SWAP -->
        <IconTabFilter key="swap" icon="sap-icon://swap" text="{i18n>titleShiftSwap}">
          <Table id="swapApprovals" items="{/ShiftSwapRequests}" noDataText="{i18n>msgNoData}" growing="true" growingThreshold="20">
            <columns>
              <Column><Text text="Requestor"/></Column>
              <Column><Text text="Target"/></Column>
              <Column><Text text="Assignment"/></Column>
              <Column><Text text="{i18n>colStatus}"/></Column>
              <Column><Text text="Eligibility"/></Column>
              <Column><Text text="{i18n>colReason}"/></Column>
              <Column><Text text="{i18n>colAction}"/></Column>
            </columns>
            <items>
              <ColumnListItem>
                <cells>
                  <Text text="{requestor_ID}"/>
                  <Text text="{targetEmployee_ID}"/>
                  <Text text="{assignment_ID}"/>
                  <ObjectStatus text="{path:'status', formatter:'.formatter.statusText'}" state="{path:'status', formatter:'.formatter.statusState'}"/>
                  <Text text="{eligibilityMessages}" maxLines="2"/>
                  <Text text="{reason}" maxLines="2"/>
                  <HBox>
                    <Button icon="sap-icon://accept" type="Accept" tooltip="{i18n>btnApprove}" press="onApproveSwap"/>
                    <Button icon="sap-icon://sys-cancel-2" type="Reject" tooltip="{i18n>btnReject}" press="onRejectSwap"/>
                  </HBox>
                </cells>
              </ColumnListItem>
            </items>
          </Table>
        </IconTabFilter>
      </items>
    </IconTabBar>
  </Page>
</mvc:View>
