<mvc:View
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  displayBlock="true"
  controllerName="hr.fiori.controller.OvertimeList"
  height="100%">
  <Page title="{i18n>titleOvertimeList}" showNavButton="true" navButtonPress="onNavBack">
    <headerContent>
      <Button icon="sap-icon://add" type="Emphasized" text="{i18n>btnSubmitOvertime}" press="onCreate"/>
    </headerContent>
    <subHeader>
      <Toolbar>
        <Select id="statusFilter" selectedKey="ALL" change="onFilterChange" width="200px">
          <items>
            <core:Item key="ALL" text="All Status"/>
            <core:Item key="DRAFT" text="Draft"/>
            <core:Item key="PENDING_MANAGER" text="Pending Approval"/>
            <core:Item key="APPROVED" text="Approved"/>
            <core:Item key="REJECTED" text="Rejected"/>
          </items>
        </Select>
        <ToolbarSpacer/>
        <Button icon="sap-icon://export" text="{i18n>btnExport}" press="onExport"/>
      </Toolbar>
    </subHeader>

    <Table id="otTable" items="{/OvertimeRequests}" growing="true" growingThreshold="20" noDataText="{i18n>msgNoData}">
      <columns>
        <Column><Text text="{i18n>colWorkDate}"/></Column>
        <Column><Text text="{i18n>colOtStart}"/></Column>
        <Column><Text text="{i18n>colOtEnd}"/></Column>
        <Column><Text text="{i18n>colOtHours}"/></Column>
        <Column><Text text="{i18n>colOtType}"/></Column>
        <Column><Text text="{i18n>colMultiplier}"/></Column>
        <Column><Text text="{i18n>colAmount}"/></Column>
        <Column><Text text="{i18n>colCompOff}"/></Column>
        <Column><Text text="{i18n>colStatus}"/></Column>
      </columns>
      <items>
        <ColumnListItem>
          <cells>
            <Text text="{path:'workDate', type:'sap.ui.model.odata.type.Date'}"/>
            <Text text="{otStart}"/>
            <Text text="{otEnd}"/>
            <Text text="{path:'otHours', type:'sap.ui.model.odata.type.Decimal'}"/>
            <Text text="{path:'otType', formatter:'.formatter.otTypeText'}"/>
            <Text text="{path:'multiplier', type:'sap.ui.model.odata.type.Decimal'}"/>
            <Text text="{path:'estimatedAmount', type:'sap.ui.model.odata.type.Decimal', formatOptions:{showMeasure:false}}"/>
            <Text text="{path:'compOffCredits', type:'sap.ui.model.odata.type.Decimal'}"/>
            <ObjectStatus text="{path:'status', formatter:'.formatter.statusText'}" state="{path:'status', formatter:'.formatter.statusState'}"/>
          </cells>
        </ColumnListItem>
      </items>
    </Table>
  </Page>
</mvc:View>
