<mvc:View
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  displayBlock="true"
  controllerName="hr.fiori.controller.HRCompliance"
  height="100%">
  <Page title="{i18n>titleHRCompliance}" showNavButton="true" navButtonPress="onNavBack">
    <headerContent>
      <Button icon="sap-icon://add" text="Add Compliance Rule" type="Emphasized" press="onAddRule"/>
      <Button icon="sap-icon://add" text="Add OT Policy" press="onAddOtPolicy"/>
    </headerContent>

    <Panel headerText="Labor Compliance Rules (working hour limits)" class="sapUiResponsiveMargin">
      <Table id="rulesTable" items="{/ComplianceRules}" mode="None" noDataText="{i18n>msgNoData}">
        <columns>
          <Column><Text text="Jurisdiction"/></Column>
          <Column><Text text="Daily Max (h)"/></Column>
          <Column><Text text="Weekly Regular (h)"/></Column>
          <Column><Text text="Weekly OT Allowance"/></Column>
          <Column><Text text="Weekly Max (h)"/></Column>
          <Column><Text text="Quarterly OT Limit"/></Column>
          <Column><Text text="Warn At"/></Column>
          <Column><Text text="Min Rest (h)"/></Column>
          <Column><Text text="Effective From"/></Column>
        </columns>
        <items>
          <ColumnListItem>
            <cells>
              <Text text="{jurisdiction}"/>
              <Text text="{dailyMaxHours}"/>
              <Text text="{weeklyRegularHours}"/>
              <Text text="{weeklyOTAllowance}"/>
              <Text text="{weeklyMaxHours}"/>
              <Text text="{quarterlyOTLimit}"/>
              <Text text="{quarterlyWarnAt}"/>
              <Text text="{minRestHours}"/>
              <Text text="{path:'effectiveFrom', type:'sap.ui.model.odata.type.Date'}"/>
            </cells>
          </ColumnListItem>
        </items>
      </Table>
    </Panel>

    <Panel headerText="Overtime Multiplier Policies" class="sapUiResponsiveMargin">
      <Table id="otPoliciesTable" items="{/OvertimePolicies}" mode="None" noDataText="{i18n>msgNoData}">
        <columns>
          <Column><Text text="OT Type"/></Column>
          <Column><Text text="Multiplier"/></Column>
          <Column><Text text="Comp-Off Conversion Rate"/></Column>
          <Column><Text text="Jurisdiction"/></Column>
          <Column><Text text="Effective From"/></Column>
        </columns>
        <items>
          <ColumnListItem>
            <cells>
              <Text text="{otType}"/>
              <Text text="{path:'multiplier', type:'sap.ui.model.odata.type.Decimal'}"/>
              <Text text="{path:'compOffConversionRate', type:'sap.ui.model.odata.type.Decimal'}"/>
              <Text text="{jurisdiction}"/>
              <Text text="{path:'effectiveFrom', type:'sap.ui.model.odata.type.Date'}"/>
            </cells>
          </ColumnListItem>
        </items>
      </Table>
    </Panel>

    <MessageStrip text="All thresholds above are configurable examples. Validate the applicable jurisdiction, employee category, statutory limits, exceptions and effective dates before production use." type="Warning" showIcon="true" class="sapUiResponsiveMargin"/>
  </Page>
</mvc:View>
