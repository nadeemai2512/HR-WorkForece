{
  "name": "hr-fiori-app",
  "version": "1.0.0",
  "description": "SAPUI5 / Fiori frontend for HR Workforce Management",
  "scripts": {
    "start": "ui5 serve --config ui5.yaml --port 8080",
    "build": "ui5 build --config ui5.yaml --all --dest dist",
    "build-deploy": "ui5 build --config ui5.yaml --all --dest ../../approuter/resources/webapp"
  },
  "devDependencies": {
    "@ui5/cli": "^3.12.0",
    "@sap/ux-ui5-tooling": "^1.14.0"
  }
}
