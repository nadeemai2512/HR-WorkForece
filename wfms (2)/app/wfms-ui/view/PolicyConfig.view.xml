<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core"
    controllerName="wfms.ui.controller.PolicyConfig" displayBlock="true">
    <Page title="Policy Configuration" showNavButton="true" navButtonPress="onNavBack">
        <VBox class="sapUiSmallMargin">
            <IconTabBar>
                <items>
                    <IconTabFilter text="Leave Types" key="lt">
                        <Table items="{/LeaveTypes}" growing="true" growingThreshold="10">
                            <columns>
                                <Column><Text text="Code" /></Column><Column><Text text="Name" /></Column>
                                <Column><Text text="Entitlement" /></Column><Column><Text text="Neg. Bal." /></Column>
                                <Column><Text text="Cert After" /></Column><Column><Text text="Exempt Blackout" /></Column>
                                <Column><Text text="Exempt Notice" /></Column><Column><Text text="Carry Fwd" /></Column>
                                <Column><Text text="Max Carry" /></Column><Column><Text text="Active" /></Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells><Text text="{code}" /><Text text="{name}" /><Text text="{defaultEntitlementDays}" />
                                        <Text text="{path:'allowNegativeBalance', formatter:'.formatters.yesNo'}" />
                                        <Text text="{requireCertificateAfterDays}" />
                                        <Text text="{path:'exemptFromBlackout', formatter:'.formatters.yesNo'}" />
                                        <Text text="{path:'exemptFromAdvanceNotice', formatter:'.formatters.yesNo'}" />
                                        <Text text="{path:'eligibleForCarryForward', formatter:'.formatters.yesNo'}" />
                                        <Text text="{maxCarryForwardDays}" />
                                        <ObjectStatus text="{path:'active', formatter:'.formatters.yesNo'}" state="{= ${active} ? 'Success' : 'Error' }" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </IconTabFilter>
                    <IconTabFilter text="Leave Policies" key="lp">
                        <Table items="{path:'/LeavePolicies', parameters:{$expand:'leaveType'}}" growing="true" growingThreshold="10">
                            <columns>
                                <Column><Text text="Leave Type" /></Column><Column><Text text="Country" /></Column>
                                <Column><Text text="Min Notice (days)" /></Column><Column><Text text="Notice Threshold" /></Column>
                                <Column><Text text="Cert After" /></Column><Column><Text text="Effective" /></Column><Column><Text text="Active" /></Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells><Text text="{leaveType/name}" /><Text text="{country}" /><Text text="{minAdvanceNoticeDays}" />
                                        <Text text="{advanceNoticeThresholdDays}" /><Text text="{requireCertificateAfterDays}" />
                                        <Text text="{path:'effectiveFrom', type:'sap.ui.model.type.Date'} - {path:'effectiveTo', type:'sap.ui.model.type.Date'}" />
                                        <ObjectStatus text="{path:'active', formatter:'.formatters.yesNo'}" state="{= ${active} ? 'Success' : 'Error' }" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </IconTabFilter>
                    <IconTabFilter text="Holidays" key="h">
                        <Table items="{/CompanyHolidays}" growing="true" growingThreshold="15">
                            <columns>
                                <Column><Text text="Name" /></Column><Column><Text text="Date" /></Column>
                                <Column><Text text="Country" /></Column><Column><Text text="Region" /></Column>
                                <Column><Text text="Type" /></Column><Column><Text text="Working Day" /></Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells><Text text="{name}" /><Text text="{path:'holidayDate', type:'sap.ui.model.type.Date', formatOptions:{pattern:'dd-MMM-yyyy'}}" />
                                        <Text text="{country}" /><Text text="{region}" /><Text text="{holidayType}" />
                                        <Text text="{path:'isWorkingDay', formatter:'.formatters.yesNo'}" /></cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </IconTabFilter>
                    <IconTabFilter text="Blackouts" key="b">
                        <Table items="{/BlackoutPeriods}" growing="true" growingThreshold="10">
                            <columns>
                                <Column><Text text="Name" /></Column><Column><Text text="Start" /></Column>
                                <Column><Text text="End" /></Column><Column><Text text="Country" /></Column>
                                <Column><Text text="Applies To" /></Column><Column><Text text="Reason" /></Column><Column><Text text="Active" /></Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells><Text text="{name}" /><Text text="{path:'startDate', type:'sap.ui.model.type.Date'}" />
                                        <Text text="{path:'endDate', type:'sap.ui.model.type.Date'}" /><Text text="{country}" />
                                        <Text text="{appliesToLeaveTypes}" /><Text text="{path:'reason', formatter:'.formatters.truncate'}" />
                                        <ObjectStatus text="{path:'active', formatter:'.formatters.yesNo'}" state="{= ${active} ? 'Success' : 'Error' }" /></cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </IconTabFilter>
                    <IconTabFilter text="Shift Templates" key="st">
                        <Table items="{/ShiftTemplates}" growing="true" growingThreshold="10">
                            <columns>
                                <Column><Text text="Code" /></Column><Column><Text text="Name" /></Column>
                                <Column><Text text="Start" /></Column><Column><Text text="End" /></Column>
                                <Column><Text text="Break (min)" /></Column><Column><Text text="Active" /></Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells><Text text="{code}" /><Text text="{name}" /><Text text="{startTime}" /><Text text="{endTime}" />
                                        <Text text="{breakMinutes}" /><ObjectStatus text="{path:'active', formatter:'.formatters.yesNo'}" state="{= ${active} ? 'Success' : 'Error' }" /></cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </IconTabFilter>
                    <IconTabFilter text="Compliance Rules" key="cr">
                        <Table items="{/ComplianceRules}" growing="true" growingThreshold="10">
                            <columns>
                                <Column><Text text="Country" /></Column><Column><Text text="Category" /></Column>
                                <Column><Text text="Daily Max (h)" /></Column><Column><Text text="Weekly Regular" /></Column>
                                <Column><Text text="Weekly OT Max" /></Column><Column><Text text="Weekly Total Max" /></Column>
                                <Column><Text text="Quarterly OT Limit" /></Column><Column><Text text="Min Rest (h)" /></Column>
                                <Column><Text text="Warn %" /></Column><Column><Text text="Effective" /></Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells><Text text="{country}" /><Text text="{employeeCategory}" /><Text text="{dailyMaxHours}" />
                                        <Text text="{weeklyRegularHours}" /><Text text="{weeklyMaxOvertime}" /><Text text="{weeklyMaxTotalHours}" />
                                        <Text text="{quarterlyOvertimeLimit}" /><Text text="{minRestHours}" /><Text text="{warningThresholdPct}" />
                                        <Text text="{path:'effectiveFrom', type:'sap.ui.model.type.Date'} - {path:'effectiveTo', type:'sap.ui.model.type.Date'}" /></cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </IconTabFilter>
                    <IconTabFilter text="Overtime Policies" key="op">
                        <Table items="{/OvertimePolicies}" growing="true" growingThreshold="10">
                            <columns>
                                <Column><Text text="Country" /></Column><Column><Text text="Weekday Mult." /></Column>
                                <Column><Text text="Weekend Mult." /></Column><Column><Text text="Holiday Mult." /></Column>
                                <Column><Text text="Comp-Off Conv. (h)" /></Column><Column><Text text="Effective" /></Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells><Text text="{country}" /><Text text="{weekdayMultiplier}" /><Text text="{weekendMultiplier}" />
                                        <Text text="{publicHolidayMultiplier}" /><Text text="{compOffConversionHours}" />
                                        <Text text="{path:'effectiveFrom', type:'sap.ui.model.type.Date'} - {path:'effectiveTo', type:'sap.ui.model.type.Date'}" /></cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </IconTabFilter>
                </items>
            </IconTabBar>
        </VBox>
    </Page>
</mvc:View>
