<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    controllerName="wfms.ui.controller.LeaveList"
    displayBlock="true">
    <Page title="{i18n>leaveTitle}" showNavButton="true" navButtonPress="onNavBack">
        <customHeader>
            <Bar>
                <contentLeft>
                    <Button icon="sap-icon://nav-back" press="onNavBack" type="Transparent" />
                </contentLeft>
                <contentMiddle><Title text="{i18n>leaveTitle}" /></contentMiddle>
                <contentRight>
                    <Button text="{i18n>leaveCreate}" icon="sap-icon://add" type="Emphasized" press="onCreate" />
                </contentRight>
            </Bar>
        </customHeader>
        <VBox class="sapUiSmallMargin">
            <Toolbar>
                <SearchField id="searchField" width="60%" placeholder="Search by reason or status" live="onSearch" />
                <Select id="statusFilter" selectedKey="all" change="onStatusChange">
                    <items>
                        <core:Item key="all" text="All Status" />
                        <core:Item key="Draft" text="Draft" />
                        <core:Item key="PendingManager" text="Pending Manager" />
                        <core:Item key="Approved" text="Approved" />
                        <core:Item key="Rejected" text="Rejected" />
                        <core:Item key="SentBack" text="Sent Back" />
                        <core:Item key="Cancelled" text="Cancelled" />
                    </items>
                </Select>
                <ToolbarSpacer />
                <Button icon="sap-icon://refresh" press="onRefresh" type="Transparent" />
            </Toolbar>

            <Table id="leaveTable"
                items="{path:'/LeaveRequests', parameters:{$expand:'employee,leaveType'}, sorter:{path:'createdAt', descending:true}}"
                growing="true" growingThreshold="20" mode="SingleSelectMaster"
                noDataText="{i18n>msgNoData}"
                itemPress="onItemPress">
                <columns>
                    <Column><Text text="{i18n>colEmployee}" /></Column>
                    <Column><Text text="{i18n>leaveType}" /></Column>
                    <Column><Text text="{i18n>leaveStart}" /></Column>
                    <Column><Text text="{i18n>leaveEnd}" /></Column>
                    <Column><Text text="{i18n>leaveDays}" /></Column>
                    <Column><Text text="{i18n>leaveStatus}" /></Column>
                    <Column><Text text="{i18n>leaveReason}" /></Column>
                </columns>
                <items>
                    <ColumnListItem type="Navigation">
                        <cells>
                            <Text text="{employee/fullName}" />
                            <Text text="{leaveType/name}" />
                            <Text text="{path:'startDate', type:'sap.ui.model.type.Date', formatOptions:{pattern:'dd-MMM-yyyy'}}" />
                            <Text text="{path:'endDate', type:'sap.ui.model.type.Date', formatOptions:{pattern:'dd-MMM-yyyy'}}" />
                            <Text text="{days}" />
                            <ObjectStatus text="{status}" state="{path:'status', formatter:'.statusValueState'}" icon="{path:'status', formatter:'.statusIcon'}" />
                            <Text text="{path:'reason', formatter:'.formatters.truncate'}" maxLines="2" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </VBox>
    </Page>
</mvc:View>
