<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.ui.layout.form" xmlns:core="sap.ui.core"
    controllerName="wfms.ui.controller.EmployeeDetail" displayBlock="true">
    <Page title="Employee Detail" showNavButton="true" navButtonPress="onNavBack">
        <VBox class="sapUiSmallMargin">
            <ObjectHeader title="{fullName}" intro="{employeeNumber} - {department/name}">
                <attributes>
                    <ObjectAttribute text="Email: {email}" />
                    <ObjectAttribute text="Status: {status}" />
                    <ObjectAttribute text="Category: {employeeCategory}" />
                    <ObjectAttribute text="Manager: {manager/fullName}" />
                    <ObjectAttribute text="Hire Date: {path:'hireDate', type:'sap.ui.model.type.Date', formatOptions:{pattern:'dd-MMM-yyyy'}}" />
                    <ObjectAttribute text="Country/Region: {country} / {region}" />
                    <ObjectAttribute text="Hourly Base Rate: ₹ {hourlyBaseRate}" />
                </attributes>
            </ObjectHeader>

            <f:SimpleForm editable="false" layout="ResponsiveGridLayout" labelSpanL="4" columnsL="2">
                <f:content>
                    <Title text="All Fields" level="H3" />
                    <Label text="ID" /><Text text="{ID}" />
                    <Label text="Employee Number" /><Text text="{employeeNumber}" />
                    <Label text="First Name" /><Text text="{firstName}" />
                    <Label text="Last Name" /><Text text="{lastName}" />
                    <Label text="Full Name" /><Text text="{fullName}" />
                    <Label text="Email" /><Text text="{email}" />
                    <Label text="Phone" /><Text text="{phone}" />
                    <Label text="Department" /><Text text="{department/name}" />
                    <Label text="Manager" /><Text text="{manager/fullName}" />
                    <Label text="Status" /><Text text="{status}" />
                    <Label text="Employee Category" /><Text text="{employeeCategory}" />
                    <Label text="Hire Date" /><Text text="{path:'hireDate', type:'sap.ui.model.type.Date'}" />
                    <Label text="Country" /><Text text="{country}" />
                    <Label text="Region" /><Text text="{region}" />
                    <Label text="Hourly Base Rate" /><Text text="{hourlyBaseRate}" />
                    <Label text="Created At" /><Text text="{path:'createdAt', type:'sap.ui.model.type.Date', formatOptions:{pattern:'dd-MMM-yyyy HH:mm'}}" />
                    <Label text="Created By" /><Text text="{createdBy}" />
                </f:content>
            </f:SimpleForm>

            <Title text="Skills" level="H3" class="wfmsSectionTitle" />
            <Table items="{skills}" noDataText="No skills">
                <columns><Column><Text text="Skill" /></Column><Column><Text text="Proficiency" /></Column><Column><Text text="Primary" /></Column></columns>
                <items><ColumnListItem><cells><Text text="{skill}" /><Text text="{proficiency}" /><Text text="{path:'primarySkill', formatter:'.formatters.yesNo'}" /></cells></ColumnListItem></items>
            </Table>

            <Title text="Leave Balances (current year)" level="H3" class="wfmsSectionTitle" />
            <Table items="{leaveBalances}" noDataText="No balances">
                <columns>
                    <Column><Text text="Leave Type" /></Column><Column><Text text="Year" /></Column>
                    <Column><Text text="Entitlement" /></Column><Column><Text text="Carry Forward" /></Column>
                    <Column><Text text="Used" /></Column><Column><Text text="Pending" /></Column><Column><Text text="Available" /></Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells><Text text="{leaveType/name}" /><Text text="{year}" /><Text text="{entitlement}" /><Text text="{carryForward}" /><Text text="{used}" /><Text text="{pending}" /><ObjectStatus text="{available}" state="Success" /></cells>
                    </ColumnListItem>
                </items>
            </Table>
        </VBox>
    </Page>
</mvc:View>
