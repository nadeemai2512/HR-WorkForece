<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.ui.layout.form" xmlns:core="sap.ui.core"
    controllerName="wfms.ui.controller.ShiftSwap" displayBlock="true">
    <Page title="Shift Swap" showNavButton="true" navButtonPress="onNavBack">
        <VBox class="sapUiSmallMargin">
            <f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanL="4" columnsL="1" class="sapUiSmallMargin">
                <f:content>
                    <Title text="Request a Shift Swap" level="H3" />
                    <Label text="My Shift to Swap" required="true" />
                    <Select id="myShift" items="{path:'/ShiftAssignments', parameters:{$expand:'shiftTemplate'}, sorter:{path:'assignmentDate'}}">
                        <items><core:Item key="{ID}" text="{path:'assignmentDate', type:'sap.ui.model.type.Date', formatOptions:{pattern:'dd-MMM'}} - {shiftTemplate/name} ({startTime}-{endTime})" /></items>
                    </Select>
                    <Label text="Swap With (colleague)" required="true" />
                    <Select id="targetEmp" items="{/Employees}">
                        <items><core:Item key="{ID}" text="{fullName} ({employeeNumber})" /></items>
                    </Select>
                    <Label text="Reason" /><TextArea id="reason" rows="3" width="100%" />
                </f:content>
            </f:SimpleForm>
            <Toolbar><Button text="Submit Swap Request" type="Emphasized" press="onSubmit" /><Button text="Cancel" press="onNavBack" type="Transparent" /></Toolbar>

            <Title text="My Shift Swap Requests" level="H3" class="wfmsSectionTitle" />
            <Table id="swapTable" items="{path:'/ShiftSwapRequests', parameters:{$expand:'requestor,targetEmployee,requestorShift'}}"
                growing="true" growingThreshold="10" noDataText="{i18n>msgNoData}">
                <columns>
                    <Column><Text text="Requestor" /></Column>
                    <Column><Text text="Target" /></Column>
                    <Column><Text text="Shift Date" /></Column>
                    <Column><Text text="Peer Decision" /></Column>
                    <Column><Text text="{i18n>leaveStatus}" /></Column>
                    <Column><Text text="Action" /></Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{requestor/fullName}" />
                            <Text text="{targetEmployee/fullName}" />
                            <Text text="{path:'requestorShift/assignmentDate', type:'sap.ui.model.type.Date', formatOptions:{pattern:'dd-MMM'}}" />
                            <ObjectStatus text="{peerDecision}" state="{path:'peerDecision', formatter:'.statusValueState'}" />
                            <ObjectStatus text="{status}" state="{path:'status', formatter:'.statusValueState'}" />
                            <HBox>
                                <Button text="Accept" type="Accept" press="onPeerAccept" enabled="{= ${status} === 'PendingPeer' }" />
                                <Button text="Reject" type="Reject" press="onPeerReject" enabled="{= ${status} === 'PendingPeer' }" />
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </VBox>
    </Page>
</mvc:View>
