<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core"
    controllerName="wfms.ui.controller.ShiftSchedule" displayBlock="true">
    <Page title="{i18n>shiftTitle}" showNavButton="true" navButtonPress="onNavBack">
        <VBox class="sapUiSmallMargin">
            <Toolbar>
                <Select id="empFilter" items="{/Employees}" change="onFilterChange">
                    <items><core:Item key="{ID}" text="{fullName}" /></items>
                </Select>
                <Select id="tplFilter" items="{/ShiftTemplates}" change="onFilterChange">
                    <items><core:Item key="{ID}" text="{name}" /></items>
                </Select>
                <ToolbarSpacer />
                <Button icon="sap-icon://refresh" press="onRefresh" type="Transparent" />
            </Toolbar>
            <Table id="shiftTable"
                items="{path:'/ShiftAssignments', parameters:{$expand:'employee,shiftTemplate'}, sorter:{path:'assignmentDate', descending:false}}"
                growing="true" growingThreshold="25" noDataText="{i18n>msgNoData}">
                <columns>
                    <Column><Text text="{i18n>colEmployee}" /></Column>
                    <Column><Text text="{i18n>shiftDate}" /></Column>
                    <Column><Text text="{i18n>shiftTemplate}" /></Column>
                    <Column><Text text="{i18n>shiftStart}" /></Column>
                    <Column><Text text="{i18n>shiftEnd}" /></Column>
                    <Column><Text text="{i18n>leaveStatus}" /></Column>
                    <Column><Text text="{i18n>shiftRest}" /></Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{employee/fullName}" />
                            <Text text="{path:'assignmentDate', type:'sap.ui.model.type.Date', formatOptions:{pattern:'EEE dd-MMM-yyyy'}}" />
                            <Text text="{shiftTemplate/name}" />
                            <Text text="{startTime}" />
                            <Text text="{endTime}" />
                            <ObjectStatus text="{status}" state="{path:'status', formatter:'.statusValueState'}" />
                            <ObjectStatus text="{path:'restViolation', formatter:'.formatters.yesNo'}" state="{= ${restViolation} ? 'Error' : 'None' }" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </VBox>
    </Page>
</mvc:View>
