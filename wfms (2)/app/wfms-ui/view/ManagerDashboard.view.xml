<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:layout="sap.ui.layout"
    xmlns:core="sap.ui.core"
    controllerName="wfms.ui.controller.ManagerDashboard"
    displayBlock="true">
    <Page id="managerDashboardPage" showHeader="false">
        <VBox class="sapUiSmallMargin">
            <VBox class="wfmsDashboardHeader">
                <Text text="{i18n>mgrDashboardTitle}" class="wfmsDashboardTitle" />
                <Text text="{i18n>mgrDashboardSubtitle}" class="wfmsDashboardSubtitle" />
            </VBox>

            <!-- KPI tiles -->
            <HBox class="wfmsKpiGrid" wrap="Wrap" width="100%">
                <GenericTile class="wfmsKpiTile" header="{i18n>kpiTeamMembers}" press="onKpiPressTeam">
    <tileContent>
        <TileContent>
            <content>
                <NumericContent value="{path:'teamMembers'}" icon="sap-icon://group" valueColor="Neutral" />
            </content>
        </TileContent>
    </tileContent>
</GenericTile>
                <GenericTile class="wfmsKpiTile" header="{i18n>kpiPresent}" press="onKpiPressTeam">
    <tileContent>
        <TileContent>
            <content>
                <NumericContent value="{path:'presentToday'}" icon="sap-icon://employee" valueColor="Good" />
            </content>
        </TileContent>
    </tileContent>
</GenericTile>
                <GenericTile class="wfmsKpiTile" header="{i18n>kpiOnLeave}" press="onKpiPressLeaveApprovals">
    <tileContent>
        <TileContent>
            <content>
                <NumericContent value="{path:'onLeaveToday'}" icon="sap-icon://away" valueColor="Critical" />
            </content>
        </TileContent>
    </tileContent>
</GenericTile>
                <GenericTile class="wfmsKpiTile" header="{i18n>kpiPendingLeaveApprovals}" press="onKpiPressLeaveApprovals">
    <tileContent>
        <TileContent>
            <content>
                <NumericContent value="{path:'pendingLeaveApprovals'}" icon="sap-icon://pending" valueColor="Critical" />
            </content>
        </TileContent>
    </tileContent>
</GenericTile>
                <GenericTile class="wfmsKpiTile" header="{i18n>kpiPendingOvertimeApprovals}" press="onKpiPressOvertimeApprovals">
    <tileContent>
        <TileContent>
            <content>
                <NumericContent value="{path:'pendingOvertimeApprovals'}" icon="sap-icon://overtime" valueColor="Critical" />
            </content>
        </TileContent>
    </tileContent>
</GenericTile>
                <GenericTile class="wfmsKpiTile" header="{i18n>kpiPendingSwaps}" press="onKpiPressSwapApprovals">
    <tileContent>
        <TileContent>
            <content>
                <NumericContent value="{path:'pendingSwapRequests'}" icon="sap-icon://synchronize" valueColor="Critical" />
            </content>
        </TileContent>
    </tileContent>
</GenericTile>
                <GenericTile class="wfmsKpiTile" header="{i18n>kpiStaffingPct}" press="onKpiPressTeam">
    <tileContent>
        <TileContent>
            <content>
                <NumericContent value="{path:'staffingPct'}" icon="sap-icon://gauge" valueColor="{path:'staffingPct', formatter:'.coverageState'}" />
            </content>
        </TileContent>
    </tileContent>
</GenericTile>
                <GenericTile class="wfmsKpiTile" header="{i18n>kpiComplianceAlerts}" press="onKpiPressCompliance">
    <tileContent>
        <TileContent>
            <content>
                <NumericContent value="{path:'complianceAlerts'}" icon="sap-icon://alert" valueColor="Error" />
            </content>
        </TileContent>
    </tileContent>
</GenericTile>
            </HBox>

            <!-- Team PlanningCalendar -->
            <Title text="Team Planning Calendar" level="H3" class="wfmsSectionTitle" />
            <PlanningCalendar id="teamCalendar"
                startDate="{calendar>/today}"
                rows="{calendar>/rows}"
                viewKey="Day"
                appointmentsVisualization="Filled"
                showEmptyIntervalHeaders="false"
                appointmentSelect="onAppointmentSelect">
                <rows>
                    <PlanningCalendarRow
                        title="{title}"
                        key="{key}"
                        appointments="{appointments}"
                        intervalHeaders="{intervalHeaders}">
                    </PlanningCalendarRow>
                </rows>
            </PlanningCalendar>

            <!-- Approval sections -->
            <Title text="{i18n>approvalTitle}" level="H2" class="wfmsSectionTitle" />
            <IconTabBar id="approvalTabs1" select="onApprovalTabSelect">
                <items>
                    <IconTabFilter text="{i18n>approvalLeave}" key="leave" icon="sap-icon://away">
                        <Table id="leaveApprovalTable"
                            items="{path:'/LeaveRequests', parameters:{$expand:'employee,leaveType'}, sorter:{path:'startDate', descending:false}}"
                            growing="true" growingThreshold="10" mode="None"
                            noDataText="{i18n>msgNoData}">
                            <columns>
                                <Column><Text text="{i18n>colEmployee}" /></Column>
                                <Column><Text text="{i18n>leaveType}" /></Column>
                                <Column><Text text="{i18n>leaveStart}" /></Column>
                                <Column><Text text="{i18n>leaveEnd}" /></Column>
                                <Column><Text text="{i18n>leaveDays}" /></Column>
                                <Column><Text text="{i18n>leaveStatus}" /></Column>
                                <Column><Text text="Action" /></Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{employee/fullName}" />
                                        <Text text="{leaveType/name}" />
                                        <Text text="{path:'startDate', type:'sap.ui.model.type.Date', formatOptions:{pattern:'dd-MMM'}}" />
                                        <Text text="{path:'endDate', type:'sap.ui.model.type.Date', formatOptions:{pattern:'dd-MMM'}}" />
                                        <Text text="{days}" />
                                        <ObjectStatus text="{status}" state="{path:'status', formatter:'.statusValueState'}" />
                                        <HBox>
                                            <Button text="Approve" type="Accept" press="onApproveLeave" enabled="{= ${status} === 'PendingManager' }" />
                                            <Button text="Reject" type="Reject" press="onRejectLeave" enabled="{= ${status} === 'PendingManager' }" />
                                        </HBox>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </IconTabFilter>
                    <IconTabFilter text="{i18n>approvalOvertime}" key="overtime" icon="sap-icon://overtime">
                        <Table id="overtimeApprovalTable"
                            items="{path:'/OvertimeRequests', parameters:{$expand:'employee'}}"
                            growing="true" growingThreshold="10" noDataText="{i18n>msgNoData}">
                            <columns>
                                <Column><Text text="{i18n>colEmployee}" /></Column>
                                <Column><Text text="{i18n>otWorkDate}" /></Column>
                                <Column><Text text="{i18n>otType}" /></Column>
                                <Column><Text text="{i18n>otMinutes}" /></Column>
                                <Column><Text text="{i18n>colAmount}" /></Column>
                                <Column><Text text="{i18n>leaveStatus}" /></Column>
                                <Column><Text text="Action" /></Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{employee/fullName}" />
                                        <Text text="{path:'workDate', type:'sap.ui.model.type.Date', formatOptions:{pattern:'dd-MMM'}}" />
                                        <Text text="{overtimeType}" />
                                        <Text text="{overtimeMinutes}" />
                                        <Text text="{path:'estimatedAmount', formatter:'.formatters.formatAmount'}" />
                                        <ObjectStatus text="{status}" state="{path:'status', formatter:'.statusValueState'}" />
                                        <HBox>
                                            <Button text="Approve" type="Accept" press="onApproveOvertime" enabled="{= ${status} === 'PendingManager' }" />
                                            <Button text="Reject" type="Reject" press="onRejectOvertime" enabled="{= ${status} === 'PendingManager' }" />
                                        </HBox>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </IconTabFilter>
                    <IconTabFilter text="{i18n>approvalSwap}" key="swap" icon="sap-icon://synchronize">
                        <Table id="swapApprovalTable"
                            items="{path:'/ShiftSwapRequests', parameters:{$expand:'requestor,targetEmployee,requestorShift'}}"
                            growing="true" growingThreshold="10" noDataText="{i18n>msgNoData}">
                            <columns>
                                <Column><Text text="Requestor" /></Column>
                                <Column><Text text="Target" /></Column>
                                <Column><Text text="Shift Date" /></Column>
                                <Column><Text text="Peer" /></Column>
                                <Column><Text text="{i18n>leaveStatus}" /></Column>
                                <Column><Text text="Action" /></Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{requestor/fullName}" />
                                        <Text text="{targetEmployee/fullName}" />
                                        <Text text="{path:'requestorShift/assignmentDate', type:'sap.ui.model.type.Date', formatOptions:{pattern:'dd-MMM'}}" />
                                        <ObjectStatus text="{peerDecision}" state="{path:'peerDecision', formatter:'.statusValueState'}" />
                                        <ObjectStatus text="{status}" state="{path:'status', formatter:'.statusValueState'}" />
                                        <HBox>
                                            <Button text="Approve" type="Accept" press="onApproveSwap" enabled="{= ${status} === 'PendingManager' }" />
                                            <Button text="Reject" type="Reject" press="onRejectSwap" enabled="{= ${status} === 'PendingManager' }" />
                                        </HBox>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </IconTabFilter>
                </items>
            </IconTabBar>
        </VBox>
    </Page>
</mvc:View>
