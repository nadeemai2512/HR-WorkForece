<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m"
    controllerName="wfms.ui.controller.AuditLog" displayBlock="true">
    <Page title="Audit Log" showNavButton="true" navButtonPress="onNavBack">
        <VBox class="sapUiSmallMargin">
            <Toolbar>
                <SearchField id="searchField" width="50%" placeholder="Search by action or entity" live="onSearch" />
                <ToolbarSpacer />
                <Button icon="sap-icon://refresh" press="onRefresh" type="Transparent" />
            </Toolbar>
            <Table id="auditTable" items="{path:'/AuditLogs', sorter:{path:'timestamp', descending:true}}"
                growing="true" growingThreshold="25" noDataText="{i18n>msgNoData}">
                <columns>
                    <Column><Text text="Timestamp" /></Column>
                    <Column><Text text="User" /></Column>
                    <Column><Text text="Action" /></Column>
                    <Column><Text text="Entity Type" /></Column>
                    <Column><Text text="Entity ID" /></Column>
                    <Column><Text text="Previous Value" /></Column>
                    <Column><Text text="New Value" /></Column>
                    <Column><Text text="Comments" /></Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{path:'timestamp', type:'sap.ui.model.odata.type.Date', formatOptions:{pattern:'dd-MMM-yyyy HH:mm:ss'}}" />
                            <Text text="{userId}" />
                            <Text text="{action}" />
                            <Text text="{entityType}" />
                            <Text text="{path:'entityID', formatter:'.formatters.truncate'}" />
                            <Text text="{path:'previousValue', formatter:'.formatters.truncate'}" maxLines="2" />
                            <Text text="{path:'newValue', formatter:'.formatters.truncate'}" maxLines="2" />
                            <Text text="{path:'comments', formatter:'.formatters.truncate'}" maxLines="2" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </VBox>
    </Page>
</mvc:View>
