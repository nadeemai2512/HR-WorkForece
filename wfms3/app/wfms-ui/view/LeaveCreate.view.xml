<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:layout="sap.ui.layout"
    xmlns:core="sap.ui.core"
    controllerName="wfms.ui.controller.LeaveCreate"
    displayBlock="true">
    <Page title="{i18n>leaveCreate}" showNavButton="true" navButtonPress="onNavBack">
        <VBox class="sapUiSmallMargin">
            <f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanL="3" labelSpanM="4" columnsL="2">
                <f:content>
                    <Title text="Leave Details" level="H3" />
                    <Label text="{i18n>leaveEmployee}" />
                    <Text text="{ui>currentEmployeeNumber}" />
                    <Label text="{i18n>leaveType}" required="true" />
                    <Select id="leaveTypeSelect" selectedKey="" change="onLeaveTypeChange" items="{/LeaveTypes}">
                        <items><core:Item key="{ID}" text="{name}" /></items>
                    </Select>
                    <Label text="{i18n>leaveStart}" required="true" />
                    <DatePicker id="startDate" valueFormat="yyyy-MM-dd" displayFormat="dd-MMM-yyyy" change="onDateChange" />
                    <Label text="{i18n>leaveEnd}" required="true" />
                    <DatePicker id="endDate" valueFormat="yyyy-MM-dd" displayFormat="dd-MMM-yyyy" change="onDateChange" />
                    <Label text="Half Day" />
                    <CheckBox id="isHalfDay" select="onDateChange" />
                    <Label text="{i18n>leaveDays}" />
                    <ObjectStatus id="daysPreview" text="—" state="Information" />
                    <Label text="{i18n>leaveReason}" />
                    <TextArea id="reason" value="" rows="3" width="100%" />
                </f:content>
            </f:SimpleForm>

            <Title text="Balance Preview" level="H3" class="wfmsSectionTitle" />
            <Table id="balancePreviewTable" items="{/LeaveBalanceView}" noDataText="Select a leave type" growing="true" growingThreshold="5">
                <columns>
                    <Column><Text text="{i18n>leaveType}" /></Column>
                    <Column><Text text="Entitlement" /></Column>
                    <Column><Text text="Used" /></Column>
                    <Column><Text text="Pending" /></Column>
                    <Column><Text text="Available" /></Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{leaveTypeName}" />
                            <Text text="{entitlement}" />
                            <Text text="{used}" />
                            <Text text="{pending}" />
                            <ObjectStatus text="{available}" state="Success" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>

            <Toolbar class="sapUiMediumMarginTop">
                <Button text="Save as Draft" press="onSaveDraft" type="Transparent" />
                <Button text="Save &amp; Submit" press="onSubmit" type="Emphasized" />
                <Button text="Cancel" press="onNavBack" type="Transparent" />
            </Toolbar>
        </VBox>
    </Page>
</mvc:View>
