<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <!--
      Reusable KPI tile. Usage:
        <core:Fragment fragmentName="wfms.ui.fragment.KpiTile" type="XML"
          binding="{...}">
        with local model providing: title, value, icon, footer, press
    -->
    <GenericTile
        class="wfmsKpiTile"
        press="press"
        sizeBehavior="Small"
        header="{title}"
        subheader="{footer}">
        <tileContent>
            <TileContent>
                <NumericContent
                    icon="{icon}"
                    value="{path:'value', type:'sap.ui.model.type.Integer'}"
                    valueColor="{color}" />
            </TileContent>
        </tileContent>
    </GenericTile>
</core:FragmentDefinition>
