{
  "VCAP_SERVICES": {
    "xsuaa": [
      {
        "label": "xsuaa",
        "name": "wfms-uaa",
        "credentials": {
          "url": "https://<your-xsuaa-subdomain>.authentication.<region>.hana.ondemand.com",
          "uaadomain": "authentication.<region>.hana.ondemand.com",
          "clientid": "sb-wfms",
          "clientsecret": "<your-client-secret>",
          "identityzone": "<your-xsuaa-subdomain>"
        }
      }
    ],
    "hana": [
      {
        "label": "hana",
        "name": "wfms-hana",
        "credentials": {
          "host": "<your-hana-host>",
          "port": "443",
          "user": "<your-hana-user>",
          "password": "<your-hana-password>",
          "schema": "WFMS_HDI"
        }
      }
    ]
  }
}
