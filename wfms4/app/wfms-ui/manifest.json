{
  "_version": "1.33.0",
  "sap.app": {
    "id": "wfms.ui",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": { "version": "1.0.0" },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "ui5template.basicSAPUI5ApplicationProject",
      "version": "1.40.12"
    },
    "dataSources": {
      "main": {
        "uri": "/odata/v4/workforce/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": { "desktop": true, "tablet": true, "phone": true }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "wfms.ui.view.App",
      "type": "XML",
      "async": true,
      "id": "App"
    },
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.f": {},
        "sap.ui.core": {},
        "sap.ui.layout": {},
        "sap.ui.table": {},
        "sap.viz": {},
        "sap.tnt": {}
      }
    },
    "contentDensities": { "compact": true, "cozy": true },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": { "bundleName": "wfms.ui.i18n.i18n" }
      },
      "": {
        "dataSource": "main",
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "resources": { "css": [ { "uri": "css/style.css" } ] },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "wfms.ui.view",
        "controlId": "app",
        "controlAggregation": "pages",
        "clearControlAggregation": false,
        "bypassed": { "target": "notFound" },
        "async": true
      },
      "routes": [
        { "name": "appHome", "pattern": "", "target": "employeeDashboard" },
        { "name": "employeeDashboard", "pattern": "employee", "target": "employeeDashboard" },
        { "name": "managerDashboard", "pattern": "manager", "target": "managerDashboard" },
        { "name": "hrDashboard", "pattern": "hr", "target": "hrDashboard" },
        { "name": "leaveList", "pattern": "leaves?query=:query:", "target": "leaveList" },
        { "name": "leaveCreate", "pattern": "leave/create", "target": "leaveCreate" },
        { "name": "leaveDetail", "pattern": "leave/{ID}", "target": "leaveDetail" },
        { "name": "overtimeList", "pattern": "overtime?query=:query:", "target": "overtimeList" },
        { "name": "overtimeCreate", "pattern": "overtime/create", "target": "overtimeCreate" },
        { "name": "overtimeDetail", "pattern": "overtime/{ID}", "target": "overtimeDetail" },
        { "name": "shiftSchedule", "pattern": "shifts", "target": "shiftSchedule" },
        { "name": "shiftSwap", "pattern": "shift-swap", "target": "shiftSwap" },
        { "name": "approvalInbox", "pattern": "approvals?type=:type:", "target": "approvalInbox" },
        { "name": "employeeManage", "pattern": "hr/employees", "target": "employeeManage" },
        { "name": "employeeDetail", "pattern": "hr/employee/{ID}", "target": "employeeDetail" },
        { "name": "policyConfig", "pattern": "hr/policies", "target": "policyConfig" },
        { "name": "reports", "pattern": "hr/reports", "target": "reports" },
        { "name": "auditLog", "pattern": "hr/audit", "target": "auditLog" },
        { "name": "notFound", "pattern": "not-found", "target": "notFound" }
      ],
      "targets": {
        "employeeDashboard": { "viewName": "EmployeeDashboard", "viewLevel": 1, "controlAggregation": "pages" },
        "managerDashboard": { "viewName": "ManagerDashboard", "viewLevel": 1, "controlAggregation": "pages" },
        "hrDashboard": { "viewName": "HRDashboard", "viewLevel": 1, "controlAggregation": "pages" },
        "leaveList": { "viewName": "LeaveList", "viewLevel": 2, "controlAggregation": "pages" },
        "leaveCreate": { "viewName": "LeaveCreate", "viewLevel": 3, "controlAggregation": "pages" },
        "leaveDetail": { "viewName": "LeaveDetail", "viewLevel": 3, "controlAggregation": "pages" },
        "overtimeList": { "viewName": "OvertimeList", "viewLevel": 2, "controlAggregation": "pages" },
        "overtimeCreate": { "viewName": "OvertimeCreate", "viewLevel": 3, "controlAggregation": "pages" },
        "overtimeDetail": { "viewName": "OvertimeDetail", "viewLevel": 3, "controlAggregation": "pages" },
        "shiftSchedule": { "viewName": "ShiftSchedule", "viewLevel": 2, "controlAggregation": "pages" },
        "shiftSwap": { "viewName": "ShiftSwap", "viewLevel": 2, "controlAggregation": "pages" },
        "approvalInbox": { "viewName": "ApprovalInbox", "viewLevel": 2, "controlAggregation": "pages" },
        "employeeManage": { "viewName": "EmployeeManage", "viewLevel": 2, "controlAggregation": "pages" },
        "employeeDetail": { "viewName": "EmployeeDetail", "viewLevel": 3, "controlAggregation": "pages" },
        "policyConfig": { "viewName": "PolicyConfig", "viewLevel": 2, "controlAggregation": "pages" },
        "reports": { "viewName": "Reports", "viewLevel": 2, "controlAggregation": "pages" },
        "auditLog": { "viewName": "AuditLog", "viewLevel": 2, "controlAggregation": "pages" },
        "notFound": { "viewName": "NotFound", "viewLevel": 1, "controlAggregation": "pages" }
      }
    }
  }
}
