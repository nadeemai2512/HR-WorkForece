<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:layout="sap.ui.layout"
    xmlns:core="sap.ui.core"
    controllerName="wfms.ui.controller.HRDashboard"
    displayBlock="true">
    <Page id="hrDashboardPage" showHeader="false">
        <VBox class="sapUiSmallMargin">
            <VBox class="wfmsDashboardHeader">
                <Text text="{i18n>hrDashboardTitle}" class="wfmsDashboardTitle" />
                <Text text="{i18n>hrDashboardSubtitle}" class="wfmsDashboardSubtitle" />
            </VBox>

            <!-- HR KPI tiles (all bound to backend counts) -->
            <HBox class="wfmsKpiGrid" wrap="Wrap" width="100%">
                <GenericTile class="wfmsKpiTile" header="Total Employees" press="onNavEmployees">
    <tileContent>
        <TileContent>
            <content>
                <NumericContent value="{ui>/empCount}" icon="sap-icon://group" valueColor="Neutral" />
            </content>
        </TileContent>
    </tileContent>
</GenericTile>
                <GenericTile class="wfmsKpiTile" header="Active Employees" press="onNavEmployees">
    <tileContent>
        <TileContent>
            <content>
                <NumericContent value="{ui>/activeEmployees}" icon="sap-icon://employee" valueColor="Good" />
            </content>
        </TileContent>
    </tileContent>
</GenericTile>
                <GenericTile class="wfmsKpiTile" header="Departments" press="onNavEmployees">
    <tileContent>
        <TileContent>
            <content>
                <NumericContent value="{ui>/deptCount}" icon="sap-icon://building" valueColor="Neutral" />
            </content>
        </TileContent>
    </tileContent>
</GenericTile>
                <GenericTile class="wfmsKpiTile" header="Leave Types" press="onNavPolicies">
    <tileContent>
        <TileContent>
            <content>
                <NumericContent value="{ui>/leaveTypeCount}" icon="sap-icon://vacation" valueColor="Neutral" />
            </content>
        </TileContent>
    </tileContent>
</GenericTile>
                <GenericTile class="wfmsKpiTile" header="Shift Templates" press="onNavPolicies">
    <tileContent>
        <TileContent>
            <content>
                <NumericContent value="{ui>/shiftTmplCount}" icon="sap-icon://calendar" valueColor="Neutral" />
            </content>
        </TileContent>
    </tileContent>
</GenericTile>
                <GenericTile class="wfmsKpiTile" header="Compliance Rules" press="onNavPolicies">
    <tileContent>
        <TileContent>
            <content>
                <NumericContent value="{ui>/complianceCount}" icon="sap-icon://alert" valueColor="Critical" />
            </content>
        </TileContent>
    </tileContent>
</GenericTile>
                <GenericTile class="wfmsKpiTile" header="Holidays (this year)" press="onNavPolicies">
    <tileContent>
        <TileContent>
            <content>
                <NumericContent value="{ui>/holidayCount}" icon="sap-icon://calendar-holiday" valueColor="Good" />
            </content>
        </TileContent>
    </tileContent>
</GenericTile>
                <GenericTile class="wfmsKpiTile" header="Audit Log Entries" press="onNavAudit">
    <tileContent>
        <TileContent>
            <content>
                <NumericContent value="{ui>/auditCount}" icon="sap-icon://history" valueColor="Neutral" />
            </content>
        </TileContent>
    </tileContent>
</GenericTile>
            </HBox>

            <!-- Section shortcuts to HR admin pages -->
            <Title text="{i18n>secEmployeeMgmt}" level="H3" class="wfmsSectionTitle" />
            <HBox class="wfmsQuickActionGrid" wrap="Wrap" width="100%">
                <Button text="Create Employee" icon="sap-icon://add-employee" type="Emphasized" press="onCreateEmployee" />
                <Button text="Manage Employees" icon="sap-icon://employee-lookup" press="onNavEmployees" />
                <Button text="Leave Balance Adjustments" icon="sap-icon://pending" press="onNavPolicies" />
            </HBox>

            <Title text="{i18n>secLeavePolicy}" level="H3" class="wfmsSectionTitle" />
            <HBox class="wfmsQuickActionGrid" wrap="Wrap" width="100%">
                <Button text="Leave Types" icon="sap-icon://vacation" press="onNavPolicies" />
                <Button text="Leave Policies" icon="sap-icon://policy" press="onNavPolicies" />
                <Button text="Holidays &amp; Blackouts" icon="sap-icon://calendar-holiday" press="onNavPolicies" />
            </HBox>

            <Title text="{i18n>secShiftConfig}" level="H3" class="wfmsSectionTitle" />
            <HBox class="wfmsQuickActionGrid" wrap="Wrap" width="100%">
                <Button text="Shift Templates" icon="sap-icon://calendar" press="onNavPolicies" />
                <Button text="View Schedule" icon="sap-icon://calendar-week" press="onNavShifts" />
            </HBox>

            <Title text="{i18n>secComplianceConfig}" level="H3" class="wfmsSectionTitle" />
            <HBox class="wfmsQuickActionGrid" wrap="Wrap" width="100%">
                <Button text="Compliance Rules" icon="sap-icon://alert" press="onNavPolicies" />
                <Button text="Overtime Policies" icon="sap-icon://time-entry-request" press="onNavPolicies" />
            </HBox>

            <Title text="{i18n>secReportsAudit}" level="H3" class="wfmsSectionTitle" />
            <HBox class="wfmsQuickActionGrid" wrap="Wrap" width="100%">
                <Button text="Reports &amp; Export" icon="sap-icon://excel-attachment" type="Emphasized" press="onNavReports" />
                <Button text="Audit Log" icon="sap-icon://history" press="onNavAudit" />
            </HBox>

            <!-- Recent audit activity table -->
            <Title text="Recent Audit Activity" level="H3" class="wfmsSectionTitle" />
            <Table id="recentAuditTable"
                items="{path:'/AuditLogs', sorter:{path:'timestamp', descending:true}}"
                growing="true" growingThreshold="8" noDataText="{i18n>msgNoData}">
                <columns>
                    <Column><Text text="Timestamp" /></Column>
                    <Column><Text text="User" /></Column>
                    <Column><Text text="Action" /></Column>
                    <Column><Text text="Entity" /></Column>
                    <Column><Text text="Comments" /></Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{path:'timestamp', type:'sap.ui.model.odata.type.Date', formatOptions:{pattern:'dd-MMM HH:mm'}}" />
                            <Text text="{userId}" />
                            <Text text="{action}" />
                            <Text text="{entityType}" />
                            <Text text="{path:'comments', formatter:'.formatters.truncate'}" maxLines="2" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </VBox>
    </Page>
</mvc:View>
