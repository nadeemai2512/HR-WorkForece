<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core"
    controllerName="wfms.ui.controller.OvertimeList" displayBlock="true">
    <Page title="{i18n>otTitle}" showNavButton="true" navButtonPress="onNavBack">
        <customHeader>
            <Bar>
                <contentLeft><Button icon="sap-icon://nav-back" press="onNavBack" type="Transparent" /></contentLeft>
                <contentMiddle><Title text="{i18n>otTitle}" /></contentMiddle>
                <contentRight><Button text="{i18n>otCreate}" icon="sap-icon://add" type="Emphasized" press="onCreate" /></contentRight>
            </Bar>
        </customHeader>
        <VBox class="sapUiSmallMargin">
            <Toolbar>
                <Select id="statusFilter" selectedKey="all" change="onStatusChange">
                    <items>
                        <core:Item key="all" text="All Status" />
                        <core:Item key="Draft" text="Draft" />
                        <core:Item key="PendingManager" text="Pending Manager" />
                        <core:Item key="Approved" text="Approved" />
                        <core:Item key="Rejected" text="Rejected" />
                    </items>
                </Select>
                <ToolbarSpacer />
                <Button icon="sap-icon://refresh" press="onRefresh" type="Transparent" />
            </Toolbar>
            <Table id="overtimeTable"
                items="{path:'/OvertimeRequests', parameters:{$expand:'employee'}, sorter:{path:'workDate', descending:true}}"
                growing="true" growingThreshold="20" noDataText="{i18n>msgNoData}" itemPress="onItemPress">
                <columns>
                    <Column><Text text="{i18n>colEmployee}" /></Column>
                    <Column><Text text="{i18n>otWorkDate}" /></Column>
                    <Column><Text text="{i18n>otType}" /></Column>
                    <Column><Text text="{i18n>otMinutes}" /></Column>
                    <Column><Text text="{i18n>otMultiplier}" /></Column>
                    <Column><Text text="{i18n>colAmount}" /></Column>
                    <Column><Text text="{i18n>leaveStatus}" /></Column>
                    <Column><Text text="{i18n>otCompOff}" /></Column>
                </columns>
                <items>
                    <ColumnListItem type="Navigation">
                        <cells>
                            <Text text="{employee/fullName}" />
                            <Text text="{path:'workDate', type:'sap.ui.model.odata.type.Date', formatOptions:{pattern:'dd-MMM-yyyy'}}" />
                            <Text text="{overtimeType}" />
                            <Text text="{overtimeMinutes}" />
                            <Text text="{multiplier}" />
                            <Text text="{path:'estimatedAmount', formatter:'.formatters.formatAmount'}" />
                            <ObjectStatus text="{status}" state="{path:'status', formatter:'.formatters.statusValueState'}" />
                            <Text text="{compOffCreditsEarned}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </VBox>
    </Page>
</mvc:View>
