<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.ui.layout.form" xmlns:core="sap.ui.core"
    controllerName="wfms.ui.controller.Reports" displayBlock="true">
    <Page title="Reports &amp; Export" showNavButton="true" navButtonPress="onNavBack">
        <VBox class="sapUiSmallMargin">
            <f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanL="4" columnsL="1">
                <f:content>
                    <Title text="Payroll Overtime Export (CSV)" level="H3" />
                    <Label text="From Date" />
                    <DatePicker id="otFrom" valueFormat="yyyy-MM-dd" displayFormat="dd-MMM-yyyy" value="2026-01-01" />
                    <Label text="To Date" />
                    <DatePicker id="otTo" valueFormat="yyyy-MM-dd" displayFormat="dd-MMM-yyyy" value="2026-12-31" />
                </f:content>
            </f:SimpleForm>
            <Toolbar>
                <Button text="Export Payroll Overtime (CSV)" icon="sap-icon://download" type="Emphasized" press="onExportPayroll" />
            </Toolbar>

            <Title text="Leave Utilization" level="H3" class="wfmsSectionTitle" />
            <Table items="{/LeaveBalanceView}" growing="true" growingThreshold="15" noDataText="{i18n>msgNoData}">
                <columns>
                    <Column><Text text="Emp. Number" /></Column><Column><Text text="Employee" /></Column>
                    <Column><Text text="Department" /></Column><Column><Text text="Leave Type" /></Column>
                    <Column><Text text="Entitlement" /></Column><Column><Text text="Used" /></Column>
                    <Column><Text text="Pending" /></Column><Column><Text text="Available" /></Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells><Text text="{employeeNumber}" /><Text text="{employeeName}" /><Text text="{departmentName}" />
                            <Text text="{leaveTypeName}" /><Text text="{entitlement}" /><Text text="{used}" />
                            <Text text="{pending}" /><ObjectStatus text="{available}" state="Success" /></cells>
                    </ColumnListItem>
                </items>
            </Table>

            <Title text="Overtime Summary" level="H3" class="wfmsSectionTitle" />
            <Table items="{/OvertimeSummary}" growing="true" growingThreshold="15" noDataText="{i18n>msgNoData}">
                <columns>
                    <Column><Text text="Emp. Number" /></Column><Column><Text text="Employee" /></Column>
                    <Column><Text text="Department" /></Column><Column><Text text="Work Date" /></Column>
                    <Column><Text text="Type" /></Column><Column><Text text="Minutes" /></Column>
                    <Column><Text text="Multiplier" /></Column><Column><Text text="Amount" /></Column>
                    <Column><Text text="Status" /></Column><Column><Text text="Compliance" /></Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells><Text text="{employeeNumber}" /><Text text="{employeeName}" /><Text text="{departmentName}" />
                            <Text text="{path:'workDate', type:'sap.ui.model.odata.type.Date', formatOptions:{pattern:'dd-MMM-yyyy'}}" />
                            <Text text="{overtimeType}" /><Text text="{overtimeMinutes}" /><Text text="{multiplier}" />
                            <Text text="{path:'estimatedAmount', formatter:'.formatters.formatAmount'}" />
                            <ObjectStatus text="{status}" state="{path:'status', formatter:'.formatters.statusValueState'}" />
                            <Text text="{path:'complianceWarning', formatter:'.formatters.truncate'}" maxLines="2" /></cells>
                    </ColumnListItem>
                </items>
            </Table>

            <Title text="Compliance Alerts" level="H3" class="wfmsSectionTitle" />
            <Table items="{/ComplianceAlerts}" growing="true" growingThreshold="15" noDataText="{i18n>msgNoData}">
                <columns>
                    <Column><Text text="Emp. Number" /></Column><Column><Text text="Employee" /></Column>
                    <Column><Text text="Alert Type" /></Column><Column><Text text="Severity" /></Column>
                    <Column><Text text="Message" /></Column><Column><Text text="As Of" /></Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells><Text text="{employeeNumber}" /><Text text="{fullName}" /><Text text="{alertType}" />
                            <ObjectStatus text="{severity}" state="{path:'severity', formatter:'.formatters.severityState'}" />
                            <Text text="{message}" /><Text text="{path:'asOfDate', type:'sap.ui.model.odata.type.Date'}" /></cells>
                    </ColumnListItem>
                </items>
            </Table>
        </VBox>
    </Page>
</mvc:View>
