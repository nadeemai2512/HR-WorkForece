<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core"
    controllerName="wfms.ui.controller.ApprovalInbox" displayBlock="true">
    <Page title="{i18n>approvalTitle}" showNavButton="true" navButtonPress="onNavBack">
        <VBox class="sapUiSmallMargin">
            <IconTabBar id="approvalTabs" select="onTabSelect">
                <items>
                    <IconTabFilter text="{i18n>approvalLeave}" key="leave" icon="sap-icon://away">
                        <Table items="{path:'/LeaveRequests', parameters:{$expand:'employee,leaveType'}, sorter:{path:'createdAt', descending:true}}"
                            growing="true" growingThreshold="20" noDataText="{i18n>msgNoData}">
                            <columns>
                                <Column><Text text="{i18n>colEmployee}" /></Column>
                                <Column><Text text="{i18n>leaveType}" /></Column>
                                <Column><Text text="{i18n>leaveStart}" /></Column>
                                <Column><Text text="{i18n>leaveEnd}" /></Column>
                                <Column><Text text="{i18n>leaveDays}" /></Column>
                                <Column><Text text="{i18n>leaveStatus}" /></Column>
                                <Column><Text text="Action" /></Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{employee/fullName}" />
                                        <Text text="{leaveType/name}" />
                                        <Text text="{path:'startDate', type:'sap.ui.model.odata.type.Date', formatOptions:{pattern:'dd-MMM'}}" />
                                        <Text text="{path:'endDate', type:'sap.ui.model.odata.type.Date', formatOptions:{pattern:'dd-MMM'}}" />
                                        <Text text="{days}" />
                                        <ObjectStatus text="{status}" state="{path:'status', formatter:'.formatters.statusValueState'}" />
                                        <HBox>
                                            <Button text="Approve" type="Accept" press="onApproveLeave" enabled="{= ${status} === 'PendingManager' }" />
                                            <Button text="Reject" type="Reject" press="onRejectLeave" enabled="{= ${status} === 'PendingManager' }" />
                                            <Button text="Detail" press="onLeaveDetail" />
                                        </HBox>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </IconTabFilter>
                    <IconTabFilter text="{i18n>approvalOvertime}" key="overtime" icon="sap-icon://time-entry-request">
                        <Table items="{path:'/OvertimeRequests', parameters:{$expand:'employee'}}"
                            growing="true" growingThreshold="20" noDataText="{i18n>msgNoData}">
                            <columns>
                                <Column><Text text="{i18n>colEmployee}" /></Column>
                                <Column><Text text="{i18n>otWorkDate}" /></Column>
                                <Column><Text text="{i18n>otType}" /></Column>
                                <Column><Text text="{i18n>colAmount}" /></Column>
                                <Column><Text text="{i18n>leaveStatus}" /></Column>
                                <Column><Text text="Action" /></Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{employee/fullName}" />
                                        <Text text="{path:'workDate', type:'sap.ui.model.odata.type.Date', formatOptions:{pattern:'dd-MMM'}}" />
                                        <Text text="{overtimeType}" />
                                        <Text text="{path:'estimatedAmount', formatter:'.formatters.formatAmount'}" />
                                        <ObjectStatus text="{status}" state="{path:'status', formatter:'.formatters.statusValueState'}" />
                                        <HBox>
                                            <Button text="Approve" type="Accept" press="onApproveOt" enabled="{= ${status} === 'PendingManager' }" />
                                            <Button text="Reject" type="Reject" press="onRejectOt" enabled="{= ${status} === 'PendingManager' }" />
                                        </HBox>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </IconTabFilter>
                    <IconTabFilter text="{i18n>approvalSwap}" key="swap" icon="sap-icon://synchronize">
                        <Table items="{path:'/ShiftSwapRequests', parameters:{$expand:'requestor,targetEmployee,requestorShift'}}"
                            growing="true" growingThreshold="20" noDataText="{i18n>msgNoData}">
                            <columns>
                                <Column><Text text="Requestor" /></Column>
                                <Column><Text text="Target" /></Column>
                                <Column><Text text="Shift Date" /></Column>
                                <Column><Text text="{i18n>leaveStatus}" /></Column>
                                <Column><Text text="Action" /></Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{requestor/fullName}" />
                                        <Text text="{targetEmployee/fullName}" />
                                        <Text text="{path:'requestorShift/assignmentDate', type:'sap.ui.model.odata.type.Date', formatOptions:{pattern:'dd-MMM'}}" />
                                        <ObjectStatus text="{status}" state="{path:'status', formatter:'.formatters.statusValueState'}" />
                                        <HBox>
                                            <Button text="Approve" type="Accept" press="onApproveSwap" enabled="{= ${status} === 'PendingManager' }" />
                                            <Button text="Reject" type="Reject" press="onRejectSwap" enabled="{= ${status} === 'PendingManager' }" />
                                        </HBox>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </IconTabFilter>
                </items>
            </IconTabBar>
        </VBox>
    </Page>
</mvc:View>
